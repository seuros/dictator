{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "dictator",
      "include-component-in-tag": true,
      "extra-files": [
        "Cargo.toml",
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source && @.name.value.match(/^dictator/))].version"
        }
      ]
    }
  }
}
