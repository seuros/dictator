{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "dictator",
      "include-component-in-tag": true,
      "extra-files": [
        "Cargo.toml",
        "crates/dictator-kjr/Cargo.toml",
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source && @.name.value.match(/^dictator/))].version"
        },
        {
          "type": "toml",
          "path": "crates/dictator-kjr/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'dictator-decree-abi')].version"
        },
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.packages[0].version"
        }
      ]
    }
  }
}
